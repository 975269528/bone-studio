# MCP stdio adapter discovery. Optional; defaults to %APPDATA%/BoneStudio/ai-connection.json.
BONE_STUDIO_CONNECTION=C:\Users\your-name\AppData\Roaming\BoneStudio\ai-connection.json

# Optional desktop storage override. Must be an absolute directory; omit for the normal profile.
# BONE_STUDIO_USER_DATA=C:\Users\your-name\AppData\Roaming\BoneStudio-test
# Automated verification only: 1 keeps the desktop window hidden; omit for a visible editor.
# BONE_STUDIO_HIDDEN=1
